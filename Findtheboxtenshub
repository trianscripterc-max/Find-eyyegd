----------------------------------------------------------------
-- SECTION 1: SERVER
----------------------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remote = ReplicatedStorage:FindFirstChild("XRTCF_Remote")

if not remote then
    remote = Instance.new("RemoteEvent")
    remote.Name = "XRTCF_Remote"
    remote.Parent = ReplicatedStorage
end

local states = {}
local cooldowns = {}
local initialized = {}

local function broadcast(player, enabled)
    for _, viewer in ipairs(Players:GetPlayers()) do
        remote:FireClient(viewer, "Visibility", player.UserId, enabled)
    end
end

local function setInvisible(player, enabled)
    states[player.UserId] = enabled
    player:SetAttribute("XRTCF_Invisible", enabled)
    broadcast(player, enabled)
end

remote.OnServerEvent:Connect(function(player, action, value)
    if action == "Sync" then
        for userId, enabled in pairs(states) do
            if enabled then
                remote:FireClient(player, "Visibility", userId, true)
            end
        end
        return
    end

    if action ~= "Invisible" then return end
    if typeof(value) ~= "boolean" then return end

    local now = os.clock()

    if cooldowns[player] and now - cooldowns[player] < 0.2 then
        return
    end

    cooldowns[player] = now
    setInvisible(player, value)
end)

local function setupPlayer(player)
    if initialized[player] then return end
    initialized[player] = true
    states[player.UserId] = false

    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        broadcast(player, states[player.UserId] == true)
    end)
end

Players.PlayerAdded:Connect(setupPlayer)

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

Players.PlayerRemoving:Connect(function(player)
    states[player.UserId] = nil
    cooldowns[player] = nil
    initialized[player] = nil
    broadcast(player, false)
end)

----------------------------------------------------------------
-- SECTION 2: CLIENT
-- Separate LocalScript in StarterPlayerScripts.
----------------------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LP = Players.LocalPlayer
local Remote = ReplicatedStorage:WaitForChild("XRTCF_Remote")

local enabled = false
local visibility = {}
local originals = setmetatable({}, {__mode = "k"})
local characterConnections = {}

local function updateCharacter(player)
    if not player or not player.Character then return end

    local active = visibility[player.UserId] == true
    local transparency = player == LP and 0.65 or 1

    for _, obj in ipairs(player.Character:GetDescendants()) do
        if obj:IsA("BasePart") then
            if originals[obj] == nil then
                originals[obj] = obj.LocalTransparencyModifier
            end

            obj.LocalTransparencyModifier = active
                and transparency or originals[obj]

        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            if originals[obj] == nil then
                originals[obj] = obj.Transparency
            end

            obj.Transparency = active
                and math.max(originals[obj], transparency)
                or originals[obj]
        end
    end
end

local function updatePlayer(userId, state)
    visibility[userId] = state

    local player = Players:GetPlayerByUserId(userId)

    if player then
        updateCharacter(player)
    end
end

Remote.OnClientEvent:Connect(function(action, userId, state)
    if action == "Visibility" then
        updatePlayer(userId, state)
    end
end)

local function watchPlayer(player)
    if characterConnections[player] then
        characterConnections[player]:Disconnect()
    end

    characterConnections[player] = player.CharacterAdded:Connect(function(character)
        task.wait(0.3)
        updateCharacter(player)

        character.DescendantAdded:Connect(function()
            task.defer(updateCharacter, player)
        end)
    end)

    if player.Character then
        updateCharacter(player)

        player.Character.DescendantAdded:Connect(function()
            task.defer(updateCharacter, player)
        end)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    watchPlayer(player)
end

Players.PlayerAdded:Connect(watchPlayer)

Players.PlayerRemoving:Connect(function(player)
    visibility[player.UserId] = nil

    if characterConnections[player] then
        characterConnections[player]:Disconnect()
        characterConnections[player] = nil
    end
end)

Remote:FireServer("Sync")

