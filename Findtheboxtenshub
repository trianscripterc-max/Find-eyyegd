    label.Size = UDim2.new(1, -12, 0, 40)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(110, 190, 255)
    label.TextSize = 17
    label.Font = Enum.Font.GothamBold
    label.Parent = content

    if name == "PLAYER" then
        local button

        button = createAction(
            "INVISIBILITY: " .. (enabled and "ON" or "OFF"),
            function()
                enabled = not enabled
                Remote:FireServer("Invisible", enabled)

                button.Text = "INVISIBILITY: "
                    .. (enabled and "ON" or "OFF")

                button.BackgroundColor3 = enabled
                    and Color3.fromRGB(35, 115, 75)
                    or Color3.fromRGB(40, 45, 59)
            end
        )

        button.BackgroundColor3 = enabled
            and Color3.fromRGB(35, 115, 75)
            or Color3.fromRGB(40, 45, 59)

    elseif name == "HOME" then
        createAction("XRTCF TITAN HUB", function() end)
        createAction("Status: Ready", function() end)

    elseif name == "COMBAT" then
        createAction("Combat integration", function()
            print("Connect your own combat system here")
        end)

    elseif name == "ESP" then
        createAction("Visual integration", function()
            print("Connect your own ESP system here")
        end)

    elseif name == "AUTO" then
        createAction("Testing automation", function()
            print("Connect your own test automation here")
        end)

    elseif name == "MOVEMENT" then
        createAction("Movement integration", function()
            print("Connect your own movement system here")
        end)

    elseif name == "SETTINGS" then
        createAction("Re-sync visibility", function()
            Remote:FireServer("Sync")
        end)

        createAction("Close HUB", function()
            gui.Enabled = false
        end)
    end
end

